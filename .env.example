# Required
GEMINI_API_KEY=
DATABASE_URL=postgresql+asyncpg://tkp:tkp@localhost:5433/tkp
BACKEND_API_KEY=change-me-to-a-long-random-secret

# Optional — app runs in Gemini-only mode if absent
GROQ_API_KEY=

# App
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501

# Streamlit frontend → API
TKP_API_URL=http://localhost:8000
TKP_API_KEY=change-me-to-a-long-random-secret

# Pipeline
MAX_UPLOAD_BYTES=26214400
MAX_VALIDATION_RETRIES=2
FAITHFULNESS_THRESHOLD=0.85
EMBEDDING_DIM=768
